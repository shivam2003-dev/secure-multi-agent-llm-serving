{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivam2003-dev/secure-multi-agent-llm-serving/schemas/manifest.schema.json",
  "title": "AegisBench run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at_utc",
    "completed_at_utc",
    "duration_s",
    "code",
    "runtime",
    "configuration",
    "trace",
    "engine",
    "treatment",
    "events",
    "secret_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "duration_s": { "type": "number", "minimum": 0 },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_dirty", "aegisbench_version"],
      "properties": {
        "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "git_dirty": { "type": "boolean" },
        "aegisbench_version": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {
        "python": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "benchmark", "seed"],
      "properties": {
        "path": { "type": "string" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "benchmark": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requests"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requests": { "type": "integer", "minimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "endpoints"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_scale",
        "scheduler_policy",
        "cache_isolation",
        "speculative_decoding",
        "batching",
        "kv_cache",
        "failure_recovery"
      ],
      "properties": {
        "time_scale": { "type": "number", "exclusiveMinimum": 0 },
        "scheduler_policy": {
          "enum": ["round_robin", "tenant_affinity", "workflow_cache_fair"]
        },
        "cache_isolation": {
          "enum": ["none", "per_tenant", "per_tenant_salt"]
        },
        "speculative_decoding": { "$ref": "#/$defs/mechanism" },
        "batching": { "$ref": "#/$defs/mechanism" },
        "kv_cache": { "$ref": "#/$defs/mechanism" },
        "failure_recovery": { "$ref": "#/$defs/mechanism" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "total",
        "successful",
        "usage_reported",
        "cache_reported",
        "speculation_reported",
        "cross_tenant_reported",
        "security_reported"
      ],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "total": { "type": "integer", "minimum": 0 },
        "successful": { "type": "integer", "minimum": 0 },
        "usage_reported": { "type": "integer", "minimum": 0 },
        "cache_reported": { "type": "integer", "minimum": 0 },
        "speculation_reported": { "type": "integer", "minimum": 0 },
        "cross_tenant_reported": { "type": "integer", "minimum": 0 },
        "security_reported": { "type": "integer", "minimum": 0 }
      }
    },
    "secret_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_values_recorded", "prompt_bodies_recorded"],
      "properties": {
        "environment_values_recorded": { "const": false },
        "prompt_bodies_recorded": { "const": false }
      }
    }
  },
  "$defs": {
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "method": { "type": "string" },
        "draft_model": { "type": "string" },
        "speculative_tokens": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string" },
        "client_max_concurrency": { "type": "integer", "minimum": 1 },
        "max_num_batched_tokens": { "type": "integer", "minimum": 1 },
        "prefix_caching": { "type": "boolean" },
        "tiers": { "type": "array", "items": { "type": "string" } },
        "checkpoint": { "type": "string" },
        "fault_types": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

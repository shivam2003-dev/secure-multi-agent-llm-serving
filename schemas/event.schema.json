{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shivam2003-dev/secure-multi-agent-llm-serving/schemas/event.schema.json",
  "title": "AegisBench client result event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "config_digest",
    "request_id",
    "workflow_id",
    "tenant_id",
    "security_domain",
    "agent_id",
    "role",
    "prefix_group",
    "endpoint",
    "arrival_s",
    "start_s",
    "first_token_s",
    "end_s",
    "deadline_ms",
    "ttft_slo_ms",
    "tpot_slo_ms",
    "requested_prompt_tokens",
    "requested_output_tokens",
    "prompt_tokens",
    "output_tokens",
    "cache_hit_tokens",
    "usage_reported",
    "scheduler_policy",
    "scheduler_score",
    "scheduler_components",
    "predicted_cache_affinity",
    "admission_wait_ms",
    "speculative_proposed",
    "speculative_accepted",
    "fault_recovery_ms",
    "cross_tenant_cache_hits",
    "security_violations",
    "success",
    "error"
  ],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "config_digest": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "request_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "security_domain": { "type": "string" },
    "agent_id": { "type": "string" },
    "role": { "type": "string" },
    "prefix_group": { "type": "string" },
    "endpoint": { "type": ["string", "null"] },
    "arrival_s": { "type": "number", "minimum": 0 },
    "start_s": { "type": "number", "minimum": 0 },
    "first_token_s": { "type": ["number", "null"], "minimum": 0 },
    "end_s": { "type": "number", "minimum": 0 },
    "deadline_ms": { "type": "number", "exclusiveMinimum": 0 },
    "ttft_slo_ms": { "type": "number", "exclusiveMinimum": 0 },
    "tpot_slo_ms": { "type": "number", "exclusiveMinimum": 0 },
    "requested_prompt_tokens": { "type": "integer", "minimum": 1 },
    "requested_output_tokens": { "type": "integer", "minimum": 1 },
    "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_hit_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "usage_reported": { "type": "boolean" },
    "scheduler_policy": {
      "type": ["string", "null"],
      "enum": ["round_robin", "tenant_affinity", "workflow_cache_fair", null]
    },
    "scheduler_score": { "type": ["number", "null"] },
    "scheduler_components": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "predicted_cache_affinity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "admission_wait_ms": { "type": "number", "minimum": 0 },
    "speculative_proposed": { "type": ["integer", "null"], "minimum": 0 },
    "speculative_accepted": { "type": ["integer", "null"], "minimum": 0 },
    "fault_recovery_ms": { "type": ["number", "null"], "minimum": 0 },
    "cross_tenant_cache_hits": { "type": ["integer", "null"], "minimum": 0 },
    "security_violations": { "type": ["integer", "null"], "minimum": 0 },
    "success": { "type": "boolean" },
    "error": { "type": ["string", "null"] }
  }
}
